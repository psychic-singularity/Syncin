# ==============================================================================
# Collaborative Code Editor — Environment Variables
# Copy to .env for local development with docker-compose
# ==============================================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:npg_9qzLDts0gPoi@ep-patient-king-bdatooyn-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="collab_editor"
POSTGRES_PORT=5432

# Cache & Message Broker (Redis)
REDIS_URL="redis://localhost:6379"
REDIS_PORT=6379

# Authentication & Security
# Shared secret for signing/verifying short-lived WebSocket access JWTs
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars-long"

# Next.js Web App
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"

# WebSocket Server Instances
WS_PORT_1=4001
WS_PORT_2=4002
WS_PORT=4000 # Nginx load balancer port proxying to WS_PORT_1 and WS_PORT_2
INSTANCE_ID="ws-node-1"

# Compaction Worker
COMPACTION_INTERVAL_MS=300000     # 5 minutes
COMPACTION_UPDATE_THRESHOLD=50    # compact when a document accumulates > 50 updates